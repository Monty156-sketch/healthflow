{
  "name": "healthflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @healthflow/web dev",
    "dev:api": "pnpm --filter @healthflow/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @healthflow/db generate",
    "db:migrate": "pnpm --filter @healthflow/db migrate",
    "db:seed": "pnpm --filter @healthflow/db seed"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    },
    "overrides": {
      "uuid@<11.1.1": ">=11.1.1",
      "body-parser@<2.4.0": ">=2.4.0",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "qs@<6.16.1": ">=6.16.1",
      "undici@>=7.0.0 <7.30.1": ">=7.30.1",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0"
    }
  }
}
