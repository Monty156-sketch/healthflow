# Neon connection string (from the Neon dashboard, "Pooled connection")
DATABASE_URL="postgresql://user:password@host.neon.tech/healthflow?sslmode=require"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_PEPPER="replace-me"   # extra secret mixed into refresh-token hashing, not the JWT itself

# 32-byte base64 key for encrypting MFA secrets at rest — openssl rand -base64 32
MFA_ENCRYPTION_KEY="replace-me"

# The exact origin the frontend is served from (no trailing slash)
WEB_ORIGIN="http://localhost:3000"

# Shared with the frontend's /api proxy so the forwarded visitor IP can be
# trusted. Must match PROXY_SHARED_SECRET in apps/web/.env
# Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET="replace-me"

NODE_ENV="development"
PORT="4000"

# Email (Resend or Brevo) — used for verification codes and notifications
RESEND_API_KEY=""
EMAIL_FROM="HealthFlow <no-reply@yourdomain.example>"

SENTRY_DSN=""
