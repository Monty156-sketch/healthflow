// HealthFlow frontend on Cloudflare Workers (free plan), built with the
// OpenNext adapter. Reference: https://opennext.js.org/cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "healthflow",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Public, non-secret settings. PROXY_SHARED_SECRET is NOT here: it is set
  // as a secret in the Cloudflare dashboard so it never lands in git.
  "vars": {
    "API_ORIGIN": "https://healthflow-api-eu.onrender.com"
  },

  // Keeps the API awake: see the scheduled handler in worker.mjs.
  "triggers": { "crons": ["*/5 * * * *"] },

  "observability": {
    "enabled": true
  }
}
