// HealthFlow frontend on Cloudflare Workers (free plan), built with the
// OpenNext adapter. Reference: https://opennext.js.org/cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthflow-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Lets the worker call itself for cache revalidation. The service name
  // must match "name" above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "healthflow-web"
    }
  ],

  // Public, non-secret settings. PROXY_SHARED_SECRET is NOT here: it is set
  // as a secret in the Cloudflare dashboard so it never lands in git.
  "vars": {
    "API_ORIGIN": "https://healthflow-api-0k0j.onrender.com"
  },

  "observability": {
    "enabled": true
  }
}
